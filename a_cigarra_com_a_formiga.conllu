# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:6:1:159
# text_orig = Iesu Christu, Tupana Rahira, Santissima Trindade Mucuimçaua Pessoa, Iané Piciruçára, u-icú qua mundo opé 33 acaiú, muçapiri iaci arupi rupi.
# text_source = p. 172
# text_sec = 
# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:6:2:160
# text_orig = Aé u-cemo Belem upé, Iudéa maïri-miri, iepé çúúîtá ruca-miri upé, 25 ara, Dezembro iaci, ia-ceruca Natal ara.
# text_source = p. 172
# text_sec = 
# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:6:3:161
# text_orig = I manha aé tenhen Virgem Maria, Iané Iára, Espirito Santo graça rupi, u-pitá upain ara Virgem.
# text_source = p. 172
# text_sec = 
# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:6:4:162
# text_orig = S. José anhunten i-manhanaçára reté, i-çapeiára reté iuïri.
# text_source = p. 172
# text_sec = 
# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:6:5:163
# text_orig = U-cemo ramé, angaîntá u-iuquau apgauaîtá çupé u-manhana uahá-itá u-icú mimbaua; aîta u-nheen aîta çupé: — Ia-umbeú peinhé arama iepé marandua poranga rété; u-cemo-uana Messias upainhen miraîtá uçaárú reté uahá humanidade Piciruçára arama.
# text_source = p. 172
# text_sec = 
# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:6:6:164
# text_orig = Cucecui çangaua ia-mehen uahá pe-quau arama: — Pe-çú Belem kiti.
# text_source = p. 172
# text_sec = 
# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:6:7:165
# text_orig = Ape pe-uacemo iepé taina unhenun i-manha iuhá arupi, panno miritá piterpe, iepé çúúitá ruca-miri upé.
# text_source = p. 172
# text_sec = 
# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:6:8:166
# text_orig = U-nheen pau riré qua-îtá, angaîtá u-nhengari: — Gloria Tupana Iuáca upé; catuçaua iké iuhipe catú remutára miraîtá çupé.
# text_source = p. 173
# text_sec = 
# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:6:9:167
# text_orig = Aîtá u-cahemo-uana.
# text_source = p. 173
# text_sec = 
# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:6:10:168
# text_orig = Mimbauamanhanaçaraîtá u-çú  Belem kiti, uacemo upainhen mahiê angaîtá umbeú uahá iaué.
# text_source = p. 173
# text_sec = 
# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:6:11:169
# text_orig = Aramé aîtá u-iunipian taina ruaxára, u-adorari-uana aé.
# text_source = p. 173
# text_sec = 
# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:6:12:170
# text_orig = Aramé tenhen iuïri u-iuquau iepé iacitátá turuçú, poranga, Curaci ra-pé çui, muçapiri Magos muruixauaîtá çupé.
# text_source = p. 173
# text_sec = 
# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:6:13:171
# text_orig = Aîtá u-mahan pau riré iacitátá u-nheen: — U-cemo-uana Judeoîtá muruixaua.
# text_source = p. 173
# text_sec = 
# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:6:14:172
# text_orig = Ia-çú-ana iadorari aé.
# text_source = p. 173
# text_sec = 
# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:6:15:173
# text_orig = Ieperecê u-çú-ana Belem kiti rimiaçuaîtá irumo, mimbauaîtá, upainhen mahan iuïri u-mehen arama Taina Tupana Rahira çupé.
# text_source = p. 173
# text_sec = 
# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:6:16:174
# text_orig = Iacitátá uatá u-çú u-icú aîtá renundé té Jerusalem mamé u-cahemo.
# text_source = p. 173
# text_sec = 
# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:6:17:175
# text_orig = Ape aîtá u-purandú Herodes çupé: — Mamé u-cemo Judeoîtá Muruixaua, ia-mahan uahá çangaua.
# text_source = p. 173
# text_sec = 
# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:6:18:176
# text_orig = Iadorari putari aé.
# text_source = p. 173
# text_sec = 
# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:6:19:177
# text_orig = Herodes ú-purandú pau riré pahytá çupé u-çuaxára: — Belem upé.
# text_source = p. 173
# text_sec = 
# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:6:20:178
# text_orig = Pe-çù, pe-cicari aé.
# text_source = p. 173
# text_sec = 
# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:6:21:179
# text_orig = Pe-adorari pau riré; pe-iuiri, pembeú ixé arama, a-çú putari ixé iuïri adorari aé.
# text_source = p. 173
# text_sec = 
# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:6:22:180
# text_orig = Magoîtá u-çú, aramé u-iuquau iuïri iacitátá mahá-uahá puraçú u-icú aîtá té Belem, u-pitá mamé u-icú uahá taina.
# text_source = p. 173
# text_sec = 
# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:6:23:181
# text_orig = U-cica ramé, aîtá uacemo taina i-manha iuhá arupi; aîtá adorari iuïri aé.
# text_source = p. 173
# text_sec = 
# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:6:24:182
# text_orig = Ariré iepé anga u-nheen aîtá çupé ti arama u-iuiri Jerusalem rupi; aramé aîtá u-iuiri Retama kiti amú pé rupi.
# text_source = p. 173
# text_sec = 
# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:6:25:183
# text_orig = Muruixaua Herodes u-mahan ramé ti Magoîtá u-iuquau ipiáhïua reté; u-mundú i-çuráraîtá u-çú u-iucá pau muiri tanaîtá uacemo Belem upé, uricúana uahá mucúim acaiú iuirakiti, umaité aramé u-iucá Taina Iesus.
# text_source = p. 173
# text_sec = 
# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:6:26:184
# text_orig = Iépé anga u-iuquau S. José çupé ikerpiçaua upé pituna pucuçaua, u-mundú aé u-çú-ana Egypto kiti Taina irumo i-manha iuïri.
# text_source = p. 173
# text_sec = 
# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:6:27:185
# text_orig = José u-páca ramé u-çú-ana ieperecê Egypto kiti Taina irumo i-manha iuïri.
# text_source = p. 173
# text_sec = 
# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:6:28:186
# text_orig = Ape u-pitá té mairamé u-manú-ana muruixaua Herodes.
